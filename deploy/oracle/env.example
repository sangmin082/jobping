# /etc/jobping/env — install.sh 가 처음 한 번 만든다. 이후엔 덮어쓰지 않는다.
# 바꾼 뒤:  sudo systemctl restart jobping-api

JOBPING_DB=/var/lib/jobping/jobping.db

# 운영 알림(수집 실패, 폭증 등). 비우면 journalctl 로그로만 남는다.
SLACK_WEBHOOK_URL=

# 푸시. Apple 세팅(docs/IOS.md) 후 채운다. 비어 있으면 수집·매칭은 돌고 발송만 건너뛴다.
# .p8 파일은 /etc/jobping/apns.p8 에 두고:  sudo chown root:jobping /etc/jobping/apns.p8 && sudo chmod 640 /etc/jobping/apns.p8
APNS_KEY_FILE=/etc/jobping/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.sangmin082.jobping
# TestFlight·App Store 빌드는 production. sandbox 로 두면 Apple 이 BadDeviceToken 을 주고 기기가 삭제된다.
APNS_ENVIRONMENT=production
